PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/asmmr
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=asmmr_session
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=ASMMR Administrator
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-your-smtp-password
EMAIL_FROM=ASMMR <no-reply@example.com>
# Optional. Defaults to CLIENT_URL/asmmr-logo.png and must be publicly accessible.
EMAIL_LOGO_URL=https://example.com/asmmr-logo.png
